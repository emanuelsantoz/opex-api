{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ],
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "routes": [
        {
          "src": "/api/(.*)",
          "headers": {
            "Access-Control-Allow-Origin": "http://localhost:5175",
            "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
            "Access-Control-Allow-Headers": "Content-Type, x-user-id, x-user-area, x-user-perfil, x-user-superior"
          },
          "continue": true
        }
      ]
    }
  ]
}