{
  
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "prisma generate",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/$1" }
    ],
    "regions": [
      "iad1"
    ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}