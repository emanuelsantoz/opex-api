{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ],
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "http://localhost:5175"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,DELETE,PATCH,POST,PUT,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, x-user-id, x-user-area, x-user-perfil, x-user-superior, Authorization"
        }
      ]
    }
  ],
  "key": "Access-Control-Allow-Headers",
  "value": "Content-Type, x-user-id, x-user-area, x-user-perfil, x-user-superior"
}